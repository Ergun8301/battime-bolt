/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

